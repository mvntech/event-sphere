# core
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/eventsphere
CLIENT_URL=http://localhost:5173

# auth
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# email (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EventSphere <no-reply@eventsphere.local>
EMAIL_SERVICE_API_KEY=

# file uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI layer
GEMINI_API_KEY=
